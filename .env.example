# Optional. Prefer CLI flags: --user, --token, --base-url, --input, --output.
# Do not commit `.env`.

# Application base: origin + optional context path. No /wiki, no trailing slash.
# If empty, inferred from absolute URLs in the input file.
CONFLUENCE_BASE_URL=
CONFLUENCE_EDITION=datacenter
# anonymous | bearer | basic. If empty, inferred from username/token.
CONFLUENCE_AUTH_TYPE=
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_VERIFY_SSL=true
CONFLUENCE_TIMEOUT_SECONDS=30
CONFLUENCE_MAX_RETRIES=3
EXPORT_OUTPUT_DIR=output
EXPORT_INPUT_FILE=input/urls.txt
EXPORT_FORCE_REFRESH=false
LOG_LEVEL=INFO
