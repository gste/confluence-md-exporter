# Copy to `.env` and fill in. Do not commit `.env`.
# Values here are empty or documented defaults, not real credentials.

# Application base: origin + optional context path. No /wiki, no trailing slash.
# Example: https://confluence.example.com/confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EDITION=datacenter
CONFLUENCE_AUTH_TYPE=bearer
CONFLUENCE_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_VERIFY_SSL=true
CONFLUENCE_TIMEOUT_SECONDS=30
CONFLUENCE_MAX_RETRIES=3
EXPORT_OUTPUT_DIR=output
EXPORT_INPUT_FILE=input/urls.txt
EXPORT_CONCURRENCY=2
EXPORT_FORCE_REFRESH=false
LOG_LEVEL=INFO
